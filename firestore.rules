rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isNumber(val) {
      return val is int || val is float;
    }

    // Entity Validators
    function isValidCustomer(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 30 &&
             data.shopAddress is string && data.shopAddress.size() <= 200 &&
             isNumber(data.openingBalance) && data.openingBalance >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidLedgerTransaction(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
             (data.type == 'SALE' || data.type == 'PAYMENT') &&
             data.riceVariety is string && data.riceVariety.size() <= 80 &&
             (data.unit == 'BAG' || data.unit == 'KG') &&
             isNumber(data.quantity) && data.quantity >= 0 &&
             isNumber(data.costPricePerUnit) && data.costPricePerUnit >= 0 &&
             isNumber(data.sellingPricePerUnit) && data.sellingPricePerUnit >= 0 &&
             isNumber(data.totalAmount) && data.totalAmount >= 0 &&
             isNumber(data.paidAmount) && data.paidAmount >= 0 &&
             isNumber(data.dueAdded) &&
             isNumber(data.grossProfit) &&
             data.transactionDateMillis is int && data.transactionDateMillis >= 0 &&
             data.notes is string && data.notes.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidBusinessExpense(data, userId) {
      return data.userId is string && data.userId == userId &&
             (data.frequency == 'DAILY' || data.frequency == 'MONTHLY') &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
             isNumber(data.amount) && data.amount > 0 &&
             data.notes is string && data.notes.size() <= 300 &&
             data.expenseDateMillis is int && data.expenseDateMillis >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidBankLoan(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.lenderName is string && data.lenderName.size() >= 1 && data.lenderName.size() <= 100 &&
             isNumber(data.principalAmount) && data.principalAmount > 0 &&
             isNumber(data.annualInterestRate) && data.annualInterestRate >= 0 && data.annualInterestRate <= 100 &&
             data.startDateMillis is int && data.startDateMillis >= 0 &&
             data.paidInstallmentsCount is int && data.paidInstallmentsCount >= 0 &&
             isNumber(data.totalPrincipalRepaid) && data.totalPrincipalRepaid >= 0 &&
             data.notes is string && data.notes.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // User-Scoped Subcollections
    match /users/{userId} {

      match /customers/{customerId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(customerId);

        allow create: if isOwner(userId) &&
                         isValidId(customerId) &&
                         incoming().keys().hasAll(['userId', 'name', 'phone', 'shopAddress', 'openingBalance', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'phone', 'shopAddress', 'openingBalance', 'createdAt', 'updatedAt']) &&
                         isValidCustomer(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(customerId) &&
                         isValidCustomer(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'shopAddress', 'openingBalance', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(customerId);
      }

      match /transactions/{transactionId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(transactionId);

        allow create: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         incoming().keys().hasAll(['userId', 'customerId', 'customerName', 'type', 'riceVariety', 'unit', 'quantity', 'costPricePerUnit', 'sellingPricePerUnit', 'totalAmount', 'paidAmount', 'dueAdded', 'grossProfit', 'transactionDateMillis', 'notes', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'customerId', 'customerName', 'type', 'riceVariety', 'unit', 'quantity', 'costPricePerUnit', 'sellingPricePerUnit', 'totalAmount', 'paidAmount', 'dueAdded', 'grossProfit', 'transactionDateMillis', 'notes', 'createdAt', 'updatedAt']) &&
                         isValidLedgerTransaction(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         isValidLedgerTransaction(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['customerId', 'customerName', 'type', 'riceVariety', 'unit', 'quantity', 'costPricePerUnit', 'sellingPricePerUnit', 'totalAmount', 'paidAmount', 'dueAdded', 'grossProfit', 'transactionDateMillis', 'notes', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      match /expenses/{expenseId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(expenseId);

        allow create: if isOwner(userId) &&
                         isValidId(expenseId) &&
                         incoming().keys().hasAll(['userId', 'frequency', 'category', 'amount', 'notes', 'expenseDateMillis', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'frequency', 'category', 'amount', 'notes', 'expenseDateMillis', 'createdAt', 'updatedAt']) &&
                         isValidBusinessExpense(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(expenseId) &&
                         isValidBusinessExpense(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['frequency', 'category', 'amount', 'notes', 'expenseDateMillis', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(expenseId);
      }

      match /loans/{loanId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(loanId);

        allow create: if isOwner(userId) &&
                         isValidId(loanId) &&
                         incoming().keys().hasAll(['userId', 'lenderName', 'principalAmount', 'annualInterestRate', 'startDateMillis', 'paidInstallmentsCount', 'totalPrincipalRepaid', 'notes', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'lenderName', 'principalAmount', 'annualInterestRate', 'startDateMillis', 'paidInstallmentsCount', 'totalPrincipalRepaid', 'notes', 'createdAt', 'updatedAt']) &&
                         isValidBankLoan(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(loanId) &&
                         isValidBankLoan(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['lenderName', 'principalAmount', 'annualInterestRate', 'startDateMillis', 'paidInstallmentsCount', 'totalPrincipalRepaid', 'notes', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(loanId);
      }
    }
  }
}
